{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-fetch.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pip install:*)",
      "Bash(ruff check:*)",
      "Bash(python -m py_compile:*)",
      "Bash(pytest:*)",
      "Bash(bash scripts/check_app_js.sh:*)",
      "Bash(node scripts/fe_test.js:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)"
    ]
  }
}
